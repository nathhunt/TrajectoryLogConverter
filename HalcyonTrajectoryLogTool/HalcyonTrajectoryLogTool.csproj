<Project Sdk="Microsoft.NET.Sdk">
  <!-- SDK-style .NET Framework 4.8 project: builds in Visual Studio 2019+ and in VS Code / dotnet CLI. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>HalcyonTrajectoryLogTool</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
    <AssemblyName>HalcyonTrajectoryLogTool</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\HalcyonTrajectoryLogTool.cs" Link="HalcyonTrajectoryLogTool.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- .NET Framework 4.8 reference assemblies from NuGet, so the build works in VS Code / dotnet CLI
         without installing the .NET Framework 4.8 Developer Pack. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
