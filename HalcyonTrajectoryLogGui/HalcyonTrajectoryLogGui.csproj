<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <ProjectGuid>{6F2B8C1E-3D4A-4B7E-9A51-2C8E7D0F4A13}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <RootNamespace>HalcyonTrajectoryLogTool</RootNamespace>
    <AssemblyName>HalcyonTrajectoryLogGui</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <LangVersion>7.3</LangVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <StartupObject>HalcyonTrajectoryLogTool.Gui.GuiProgram</StartupObject>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
    <PlatformTarget>x64</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\x64\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\x64\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\HalcyonTrajectoryLogTool.cs">
      <Link>HalcyonTrajectoryLogTool.cs</Link>
    </Compile>
    <Compile Include="HalcyonTrajectoryLogGui.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!-- After every build, collect what gets deployed into one folder:
       Deploy\<Configuration>\HalcyonTrajectoryLogGui.exe + LaunchHalcyonTrajectoryLogTool.cs.
       Override the folder with /p:DeployDir=<path>, e.g. msbuild /p:DeployDir=\\server\ESAPI\TrajectoryLog\ -->
  <PropertyGroup>
    <DeployDir Condition=" '$(DeployDir)' == '' ">$(MSBuildProjectDirectory)\..\Deploy\$(Configuration)\</DeployDir>
  </PropertyGroup>
  <ItemGroup>
    <DeployFile Include="$(MSBuildProjectDirectory)\..\EclipseLauncher\LaunchHalcyonTrajectoryLogTool.cs" />
  </ItemGroup>
  <Target Name="CopyToDeployFolder" AfterTargets="Build">
    <ItemGroup>
      <DeployFile Include="$(TargetPath)" />
      <DeployFile Include="$(TargetPath).config" Condition="Exists('$(TargetPath).config')" />
    </ItemGroup>
    <Copy SourceFiles="@(DeployFile)" DestinationFolder="$(DeployDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Deploy folder: $(DeployDir)" />
  </Target>
</Project>
