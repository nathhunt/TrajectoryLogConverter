<Project Sdk="Microsoft.NET.Sdk">
  <!-- SDK-style .NET Framework 4.8 project: builds in Visual Studio 2019+ and in VS Code / dotnet CLI. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>HalcyonTrajectoryLogTool</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
    <AssemblyName>HalcyonTrajectoryLogGui</AssemblyName>
    <!-- HalcyonTrajectoryLogTool.cs has its own command-line Main; start the GUI instead. -->
    <StartupObject>HalcyonTrajectoryLogTool.Gui.GuiProgram</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <!-- HalcyonTrajectoryLogGui.cs in this folder is included automatically. -->
    <Compile Include="..\HalcyonTrajectoryLogTool.cs" Link="HalcyonTrajectoryLogTool.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <!-- .NET Framework 4.8 reference assemblies from NuGet, so the build works in VS Code / dotnet CLI
         without installing the .NET Framework 4.8 Developer Pack. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- After a Release build, collect what gets deployed into one folder:
       Deploy\HalcyonTrajectoryLogGui.exe + LaunchHalcyonTrajectoryLogTool.cs. Debug builds are not copied.
       Override the folder with -p:DeployDir=<path>, e.g. dotnet build -c Release -p:DeployDir=\\server\ESAPI\TrajectoryLog\ -->
  <PropertyGroup>
    <DeployDir Condition=" '$(DeployDir)' == '' ">$(MSBuildProjectDirectory)\..\Deploy\</DeployDir>
  </PropertyGroup>
  <Target Name="CopyToDeployFolder" AfterTargets="Build" Condition=" '$(Configuration)' == 'Release' ">
    <ItemGroup>
      <DeployFile Include="$(TargetPath)" />
      <DeployFile Include="$(TargetPath).config" Condition="Exists('$(TargetPath).config')" />
      <DeployFile Include="$(MSBuildProjectDirectory)\..\EclipseLauncher\LaunchHalcyonTrajectoryLogTool.cs" />
    </ItemGroup>
    <Copy SourceFiles="@(DeployFile)" DestinationFolder="$(DeployDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Deploy folder: $(DeployDir)" />
  </Target>
</Project>
